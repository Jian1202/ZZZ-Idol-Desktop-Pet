{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "updates",
  "description": "Allow settings to read the installed version and open this project's GitHub Releases.",
  "windows": ["settings"],
  "permissions": [
    "core:app:allow-version",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/Jian1202/ZZZ-Idol-Desktop-Pet/releases" },
        { "url": "https://github.com/Jian1202/ZZZ-Idol-Desktop-Pet/releases/tag/*" }
      ]
    }
  ]
}
